:root {
    --primary: #E30613;
    --black: #2d2d2d; 
    --dark-carbon: #404040; 
    --top-nav-bg: #2d2d2d; /* Fondo oscuro para que el logo blanco se vea */
    --bg-gray: #F4F4F4;
    --white: #FFFFFF;
    --text-muted: #666666;
    --radius: 4px;
    --font-main: 'Inter', sans-serif;
    --letter-spacing: 1px;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: var(--font-main);
}

body {
    background-color: var(--white);
    color: var(--black);
    overflow-x: hidden;
}

/* LAYOUT ESTRUCTURAL */
.app-container {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
}

/* MODO INMERSIVO (FULL SCREEN) */
.immersive-mode .top-nav {
    display: none !important;
}

.immersive-mode .main-content {
    padding: 0 !important;
}

/* NAVEGACIÓN SUPERIOR */
.top-nav {
    background-color: var(--top-nav-bg);
    color: var(--white); /* Texto blanco sobre fondo oscuro */
    padding: 0 40px;
    height: 75px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 1000;
}

.logo-container {
    display: flex;
    align-items: center;
    gap: 15px;
}

.nav-logo {
    height: 45px; /* Logo un poco más grande */
    width: auto;
}

.logo-text {
    font-weight: 800;
    font-size: 1.4rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--white);
}

.nav-links {
    display: flex;
    list-style: none;
    gap: 40px;
    height: 100%;
}

.nav-links li {
    display: flex;
    align-items: center;
    height: 100%;
    position: relative;
    cursor: pointer;
}

.nav-links a {
    color: rgba(255, 255, 255, 0.7); /* Blanco semi-transparente para links inactivos */
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing);
    transition: color 0.3s;
}

.nav-links a:hover {
    color: var(--white);
}

.nav-links li.active a {
    color: var(--white);
}

.nav-links li.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background-color: var(--primary);
}

.status-label {
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--white);
}

.btn-header-action {
    background-color: var(--primary);
    color: var(--white);
    border: none;
    padding: 10px 25px;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 1.5px;
    border-radius: var(--radius);
    cursor: pointer;
    transition: background 0.3s;
}

.btn-header-action:hover {
    background-color: #c40511;
}

/* CONTENIDO PRINCIPAL */
.main-content {
    background-color: var(--bg-gray);
    padding: 0 0 60px 0;
    flex: 1;
}

.page-header {
    background-color: var(--bg-gray);
    padding: 40px 60px 20px 60px;
}

.page-header h1 {
    font-weight: 800;
    font-size: 2.2rem;
    text-transform: uppercase;
    letter-spacing: 2px;
}

.section-container {
    padding: 0px 60px; /* Recuperamos algo de aire superior e inferior */
    max-width: 1600px;
    margin: 0 auto;
}

/* STATS GRID */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    margin-bottom: 60px;
}

.stat-card {
    background-color: var(--white);
    padding: 35px 30px;
    border-radius: var(--radius);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    border: 1px solid #f0f0f0;
    display: flex;
    align-items: center;
    gap: 20px;
}

.stat-card.linkable {
    cursor: pointer;
    transition: all 0.3s ease;
}

.stat-card.linkable:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    border-color: var(--primary);
}

.stat-icon {
    width: 60px;
    height: 60px;
    border: 2px solid var(--black);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
}

.stat-info h3 {
    font-size: 0.8rem;
    text-transform: uppercase;
    color: var(--text-muted);
    letter-spacing: 1.5px;
    margin-bottom: 5px;
    font-weight: 600;
}

.stat-info p {
    font-size: 2.2rem;
    font-weight: 800;
}

.card-link {
    font-size: 0.7rem;
    font-weight: 800;
    color: var(--primary);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-top: 10px;
    display: block;
}

/* TABLAS FLAT (AHORA EN TARJETAS PREMIUN) */
.data-table-container {
    background: var(--white);
    margin-top: 40px;
    padding: 35px;
    border-radius: var(--radius);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    border: 1px solid #f0f0f0;
}

.table-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
    border-left: 6px solid var(--primary);
    padding-left: 20px;
}

.table-header h2 {
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-size: 1.4rem;
}

table {
    width: 100%;
    border-collapse: collapse;
}

thead {
    background-color: var(--dark-carbon);
    color: var(--white);
}

th {
    padding: 20px;
    text-align: left;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-weight: 600;
}

td {
    padding: 20px;
    border-bottom: 1px solid var(--bg-gray);
    font-size: 0.95rem;
}

tr:hover td {
    background-color: var(--bg-gray);
}

/* BADGES */
.badge {
    padding: 6px 12px;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    border-radius: var(--radius);
    letter-spacing: 1px;
}

.badge-pending { background: #e0e0e0; color: #444; }
.badge-assigned { background: var(--primary); color: var(--white); }

/* VISTA DE ASIGNACIÓN */
#assignment-view {
    display: none;
}

.view-header {
    display: flex;
    align-items: center;
    gap: 30px;
    padding-bottom: 30px;
    border-bottom: 1px solid #eee;
}

.btn-back {
    background: var(--black);
    color: var(--white);
    border: none;
    padding: 10px 20px;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.8rem;
    border-radius: var(--radius);
    cursor: pointer;
}

.assignment-layout {
    display: flex;
    height: calc(100vh - 85px); /* Ajustado a la nueva top bar inmersiva */
}

/* TOP BAR INMERSIVA */
.assignment-top-bar {
    height: 85px;
    background: var(--dark-carbon);
    color: var(--white);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 30px;
    border-bottom: 4px solid var(--primary);
}

.top-bar-left {
    display: flex;
    align-items: center;
    gap: 25px;
}

.btn-back-immersive {
    background: transparent;
    border: 2px solid rgba(255,255,255,0.2);
    color: var(--white);
    width: 45px;
    height: 45px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s;
}

.btn-back-immersive:hover {
    background: var(--primary);
    border-color: var(--primary);
}

.immersive-title small {
    display: block;
    text-transform: uppercase;
    font-size: 0.65rem;
    letter-spacing: 2px;
    opacity: 0.6;
}

.immersive-title h2 {
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
}

/* INFO COMPACTA EN HEADER */
.flete-compact-info {
    display: flex;
    gap: 25px;
    background: rgba(255,255,255,0.05);
    padding: 10px 25px;
    border-radius: 50px;
    border: 1px solid rgba(255,255,255,0.1);
    margin: 0 20px;
    flex-wrap: nowrap;
}

.info-item {
    display: flex;
    flex-direction: column;
}

.info-item label {
    font-size: 0.55rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--primary);
    font-weight: 800;
}

.info-item span {
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
}

.assignment-sidebar {
    width: 420px;
    background: var(--white);
    padding: 25px;
    border-right: 1px solid #e0e0e0;
    overflow-y: auto;
}

.flete-info-banner {
    background: var(--bg-gray);
    padding: 20px;
    border-radius: var(--radius);
    margin-bottom: 25px;
    border-left: 6px solid var(--primary);
}

.flete-main-info small {
    display: block;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--text-muted);
    font-size: 0.75rem;
    margin-bottom: 5px;
}

.flete-main-info div {
    font-weight: 800;
    font-size: 1.2rem;
    margin-bottom: 15px;
}

.recommendation-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.rec-card {
    border: 1px solid #e0e0e0;
    border-radius: var(--radius);
    padding: 20px;
    background: var(--white);
    position: relative;
    margin-bottom: 15px;
}

.rec-card.best {
    border: 2px solid var(--black);
    background: var(--bg-gray);
}

.rec-rank {
    position: absolute;
    top: -10px;
    left: -10px;
    width: 32px;
    height: 32px;
    background: var(--primary);
    color: var(--white);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.2rem;
    z-index: 10;
}

.rec-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 20px;
}

.rec-header h4 {
    font-weight: 800;
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.rec-header strong {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--primary);
}

.rec-driver-info {
    margin-bottom: 20px;
    display: flex;
    gap: 20px;
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 1px;
}

.rec-driver-info i {
    color: var(--primary);
}

/* PROGRESS BAR / TIMELINE */
.rec-points {
    margin-bottom: 25px;
}

.rec-points-label {
    display: block;
    margin-bottom: 10px;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 1px;
}

.rec-points-bar-bg {
    height: 2px;
    background: #e0e0e0;
    width: 100%;
    position: relative;
}

.rec-points-bar-fill {
    height: 4px;
    background: var(--primary);
    position: absolute;
    top: -1px;
    left: 0;
}

.rec-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 30px;
    padding-top: 20px;
    border-top: 1px solid #eee;
}

.rec-details p {
    font-size: 0.85rem;
}

.rec-details strong {
    display: block;
    text-transform: uppercase;
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-bottom: 5px;
}

.rec-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
    margin-bottom: 25px;
    padding-top: 15px;
    border-top: 1px solid #eee;
}

.rec-final {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 10px;
}

/* PANEL DERECHO ALTERNABLE */
.assignment-right-panel {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--bg-gray);
}

.right-panel-view {
    flex: 1;
    height: 100%;
    overflow-y: auto;
}

/* PANEL DE DETALLE */
#detail-panel {
    display: flex;
    flex-direction: column;
}

.detail-panel-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    min-height: 300px;
}

#detail-panel-content {
    padding: 35px 40px;
}

/* Botón activo en el panel de selección */
.btn-maps.active-panel {
    background: var(--primary) !important;
    color: white;
}
.btn-detail.active-panel {
    background: var(--dark-carbon) !important;
    color: white;
}

/* BOTONES DE TABLA (EJECUTAR / LIBERAR) */
.btn-assign-sm, .btn-unassign-sm {
    padding: 8px 16px;
    border: none;
    font-weight: 800;
    text-transform: uppercase;
    font-size: 0.7rem;
    letter-spacing: 1px;
    cursor: pointer;
    border-radius: var(--radius);
    transition: all 0.3s;
}

.btn-assign-sm {
    background: var(--primary);
    color: var(--white);
}

.btn-unassign-sm {
    background: var(--dark-carbon);
    color: var(--white);
}

.btn-assign-sm:hover, .btn-unassign-sm:hover {
    filter: brightness(1.2);
    transform: translateY(-1px);
}

.btn-detail, .btn-maps, .btn-assign {
    padding: 15px;
    border: none;
    font-weight: 800;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 1.5px;
    cursor: pointer;
    border-radius: var(--radius);
    transition: all 0.3s;
}

.btn-detail { background: #e0e0e0; color: var(--black); }
.btn-maps { background: var(--black); color: var(--white); }
.btn-assign { 
    background: var(--primary); 
    color: var(--white); 
    grid-column: span 2;
    margin-top: 10px;
    font-size: 1rem;
}

.btn-detail:hover, .btn-maps:hover, .btn-assign:hover {
    opacity: 0.8;
}

/* MAPA */
.assignment-map-container {
    flex: 1;
    position: relative;
    background: var(--bg-gray);
}

#map {
    height: 100%;
    width: 100%;
}

.map-placeholder {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
}

.map-placeholder i {
    font-size: 4rem;
    color: #ccc;
    margin-bottom: 20px;
    display: block;
}

.map-placeholder p {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #999;
}

/* MODAL */
.modal {
    display: none;
    position: fixed;
    z-index: 2000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.9);
}

.modal-content {
    background: var(--white);
    margin: 3% auto;
    padding: 50px;
    width: 90%;
    max-width: 800px;
    border-radius: var(--radius);
    position: relative;
}

.modal-header {
    border-bottom: 4px solid var(--black);
    padding-bottom: 20px;
    margin-bottom: 30px;
}

.modal-header h2 {
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
}

.close {
    position: absolute;
    right: 30px;
    top: 30px;
    font-size: 3rem;
    cursor: pointer;
    line-height: 1;
}

.detail-section {
    margin-bottom: 40px;
}

.detail-section h3 {
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-size: 1rem;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 15px;
}

.detail-section h3 i {
    color: var(--primary);
}

.cost-breakdown-card {
    background: var(--white);
    padding: 20px 25px;
    border-radius: var(--radius);
    border: 1px solid #eee;
}

.cost-row {
    display: flex;
    justify-content: space-between;
    padding: 12px 0;
    border-bottom: 1px solid #ddd;
    font-size: 1rem;
}

.cost-row.total {
    border-bottom: none;
    padding-top: 20px;
    font-weight: 800;
    font-size: 1.3rem;
    color: var(--primary);
}

.toll-list-item {
    display: flex;
    justify-content: space-between;
    padding: 15px;
    border: 1px solid #ddd;
    margin-bottom: 10px;
    border-radius: var(--radius);
    font-weight: 600;
}

.reporte-margen-pos { color: #10b981; font-weight: 800; }
.reporte-margen-neg { color: var(--primary); font-weight: 800; }

/* UTILS */
.dot { height: 10px; width: 10px; border-radius: 50%; background: #ccc; display: inline-block; margin-right: 10px; }
.dot.online { background: #10b981; }

.status-label {
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
}

@media (max-width: 1200px) {
    .stats-grid { grid-template-columns: 1fr; }
    .assignment-layout { flex-direction: column; }
    .assignment-sidebar { width: 100%; height: 50%; }
}